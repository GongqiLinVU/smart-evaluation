# =============================================================================
# Smart Evaluation System — Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The start.sh script sources .env automatically.
# =============================================================================

# --- Database ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=capstone_eval
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# --- Server ---
SERVER_PORT=8080
FRONTEND_PORT=5173

# --- JWT ---
EVAL_JWT_SECRET=capstone-eval-default-secret-key-change-in-production-32chars
EVAL_JWT_EXPIRATION=86400000

# --- LLM Evaluation (optional) ---
EVAL_LLM_ENABLED=false
EVAL_LLM_PROVIDER=deepseek

# Provider API keys (set the one matching your chosen provider)
EVAL_LLM_DEEPSEEK_API_KEY=
EVAL_LLM_OPENAI_API_KEY=
EVAL_LLM_ANTHROPIC_API_KEY=
EVAL_LLM_GEMINI_API_KEY=

# --- File Storage ---
EVAL_STORAGE_UPLOAD_DIR=./uploads
